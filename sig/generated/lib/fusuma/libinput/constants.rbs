module Fusuma
  module Libinput
    # libinput event type constants
    module Constants
      # Device events
      DEVICE_ADDED: ::Integer

      DEVICE_REMOVED: ::Integer

      # Pointer events
      POINTER_MOTION: ::Integer

      POINTER_MOTION_ABSOLUTE: ::Integer

      POINTER_BUTTON: ::Integer

      POINTER_AXIS: ::Integer

      POINTER_SCROLL_WHEEL: ::Integer

      POINTER_SCROLL_FINGER: ::Integer

      POINTER_SCROLL_CONTINUOUS: ::Integer

      # Touch events
      TOUCH_DOWN: ::Integer

      TOUCH_UP: ::Integer

      TOUCH_MOTION: ::Integer

      TOUCH_CANCEL: ::Integer

      TOUCH_FRAME: ::Integer

      # Maps event type to TouchRecord status
      TOUCH_STATUS_MAP: untyped

      # Maps event type to PointerRecord status.
      # POINTER_MOTION_ABSOLUTE and the deprecated POINTER_AXIS are
      # intentionally absent (AXIS would duplicate the SCROLL_* events).
      POINTER_STATUS_MAP: untyped

      # libinput_pointer_axis (for scroll value lookup)
      POINTER_AXIS_SCROLL_VERTICAL: ::Integer

      POINTER_AXIS_SCROLL_HORIZONTAL: ::Integer

      # Gesture events
      GESTURE_SWIPE_BEGIN: ::Integer

      GESTURE_SWIPE_UPDATE: ::Integer

      GESTURE_SWIPE_END: ::Integer

      GESTURE_PINCH_BEGIN: ::Integer

      GESTURE_PINCH_UPDATE: ::Integer

      GESTURE_PINCH_END: ::Integer

      GESTURE_HOLD_BEGIN: ::Integer

      GESTURE_HOLD_END: ::Integer

      # Device capabilities
      DEVICE_CAP_KEYBOARD: ::Integer

      DEVICE_CAP_POINTER: ::Integer

      DEVICE_CAP_TOUCH: ::Integer

      DEVICE_CAP_TABLET_TOOL: ::Integer

      DEVICE_CAP_TABLET_PAD: ::Integer

      DEVICE_CAP_GESTURE: ::Integer

      # libinput_config_send_events_mode
      SEND_EVENTS_ENABLED: ::Integer

      SEND_EVENTS_DISABLED: ::Integer

      # Capability name mapping for device detection
      CAPABILITY_MAP: untyped

      # Maps event type integer to [gesture, status]
      EVENT_TYPE_MAP: untyped

      # Gesture event type range for O(1) membership check
      GESTURE_EVENT_TYPE_RANGE: untyped

      DEVICE_EVENT_TYPES: untyped
    end
  end
end
