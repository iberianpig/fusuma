module Fusuma
  module Plugin
    module Inputs
      # Monitors custom commands and outputs their results as context events
      class TailContextInput < Input
        include Singleton

        # Returns the reader end of IO.pipe
        # : () -> StringIO
        def io: () -> StringIO

        # : (StringIO, StringIO) -> void
        def start: (StringIO, StringIO) -> void

        # Executes a command and returns the result
        # Returns nil on failure
        # : (String) -> String?
        def execute_command: (String) -> String?

        # Reads the tail_context section from the config file
        # Returns an empty Hash if no config is found
        # : () -> (String | Hash[untyped, untyped] | Integer | Float)
        def tail_contexts: () -> (String | Hash[untyped, untyped] | Integer | Float)

        # Executes the specified command periodically and
        # writes to writer in "name:value" format only when the value changes
        # : (name: String, command: String, writer: StringIO) -> void
        def watch_command: (name: String, command: String, writer: StringIO) -> void

        # : () -> Hash[untyped, untyped]
        def reset_last_values: () -> Hash[untyped, untyped]

        private

        DEFAULT_INTERVAL: ::Float

        def create_io: () -> untyped

        # : (StringIO) -> void
        def watch_loop: (StringIO) -> void

        def find_min_interval: (untyped contexts) -> untyped
      end
    end
  end
end
